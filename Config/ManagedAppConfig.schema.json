{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benavo.ch/apps/mountli/managed/ManagedAppConfig.schema.json",
  "title": "Mountli Managed App Configuration",
  "description": "Restriction-only managed preferences read from com.apple.configuration.managed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "PolicyVersion": { "type": "integer", "const": 1, "default": 1 },
    "AllowedBackendTypes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "uniqueItems": true,
      "description": "Missing permits every backend in the pinned runtime catalog."
    },
    "AllowConfigImport": { "type": "boolean", "default": true },
    "AllowConfigExport": { "type": "boolean", "default": true },
    "AllowInsecureTLS": { "type": "boolean", "default": false },
    "ForceReadOnly": { "type": "boolean", "default": false },
    "AllowCellular": { "type": "boolean", "default": true },
    "MaximumConcurrentTransfers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Clamped to 1–4 on iOS/iPadOS and 1–8 on macOS."
    },
    "SupportURL": { "type": "string", "format": "uri", "pattern": "^https://" }
  }
}
